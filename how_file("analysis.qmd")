```{r}
#| message: false
library(tidyverse)
library(tidycensus)
library(sf)
```

```{r}
#| message: false
edu_state <- get_acs(
  geography = "state",
  variables = c(
    "B15003_001",
    "B15003_022",
    "B15003_023",
    "B15003_024",
    "B15003_025"
  ),
  summary_var = "B15003_001",
  year = 2020
)
```

```{r}
edu_state |>
  group_by(GEOID, NAME) |>
  summarize(
    total_adults = first(summary_est),
    bachelor_higher = sum(estimate[variable %in% c(
      "B15003_022",
      "B15003_023",
      "B15003_024",
      "B15003_025"
    )]),
    percent_bachelor_higher = 100 * bachelor_higher / total_adults,
    .groups = "drop"
  ) |>
  arrange(desc(percent_bachelor_higher)) |>
  print()
```

```{r}
#| message: false
#| cache: true
income_tx <- get_acs(
  geography = "county",
  variables = "B19013_001",
  state = "TX",
  year = 2020,
  geometry = TRUE
)
```

```{r}
income_tx |>
  ggplot() +
  geom_sf(aes(fill = estimate), color = "white", linewidth = 0.1) +
  scale_fill_viridis_c(
    name = "Median household income (USD)",
    labels = scales::label_dollar()
  ) +
  labs(
    title = "Median Household Income by County in Texas",
    caption = "Source: U.S. Census Bureau, 2020 American Community Survey (ACS) 5-year estimates."
  ) +
  coord_sf(datum = NA) +
  theme_void() +
  theme(
    plot.title = element_text(face = "bold"),
    plot.caption = element_text(hjust = 0)
  )
```

